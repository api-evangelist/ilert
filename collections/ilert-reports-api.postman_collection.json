          "name": "List alert metrics for the requested resources",
          "request": {
            "name": "List alert metrics for the requested resources",
            "description": {},
            "url": {
              "path": [
                "reports",
                "alerts"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "sources",
                  "value": "<number>",
                  "description": "alert source ids to filter metrics for"
                },
                {
                  "disabled": false,
                  "key": "policies",
                  "value": "<number>",
                  "description": "escalation policy ids to filter metrics for"
                },
                {
                  "disabled": false,
                  "key": "numbers",
                  "value": "<string>",
                  "description": "phone numbers of call routing numbers to filter metrics for"
                },
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<string>",
                  "description": "(Required) date-time ISO-UTC e.g. 2021-05-25T21:24:56.771Z, start of the time range, may not exceed 1 year in total span"
                },
                {
                  "disabled": false,
                  "key": "until",
                  "value": "<string>",
                  "description": "(Required) date-time ISO-UTC e.g. 2021-05-25T21:24:56.771Z, end of the time range, must be after 'from', must not be in the future"
                },
                {
                  "disabled": false,
                  "key": "timezone",
                  "value": "<string>",
                  "description": "Time zone in which the results will be rendered, defaults to tenant's configured default timezone"
                },
                {
                  "disabled": false,
                  "key": "metric",
                  "value": "<string>",
                  "description": "Describes the metric that should be fetched choose one of: COUNT, MTTA or MTTR - defaults to COUNT"
                },
                {
                  "disabled": false,
                  "key": "group-by",
                  "value": "<string>",
                  "description": "Defines the grouping of metrics, choose one of: DAY, WEEK or MONTH - defaults to WEEK"
                },
                {
                  "disabled": false,
                  "key": "priority",
                  "value": "<string>",
                  "description": "Sets the priority filter that should be applied, choose one of: LOW, HIGH or ALL - defaults to ALL"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "b54ea967-3b1f-4b94-8bfe-13dd57f57435",
              "name": "an array of alert report metrics, each metric is another array containing data in the following order: \n\n[long:alertSourceId, long:escalationPolicyId, string:callRoutingNumberPhoneNumber, string:ISO-8601, long:value]\n\ne.g. [ [202541, 13541, \"\", \"2021-08\", 15] ]\n\nPlease note: the ISO-8601 (4th column) in this case depends on the chosen 'group-by' parameter. DAY=2021-08-01, WEEK=2021-W12, MONTH=2021-08",
              "originalRequest": {
